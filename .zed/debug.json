[
  {
    "label": "Clean",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-onchain",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "Clean",
        "build": {
          "command": "cargo",
          "args": ["clean"],
        },
      },
    ],
  },
  {
    "label": "Lint (clippy)",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-onchain",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "Lint (clippy)",
        "build": {
          "command": "cargo",
          "args": ["clippy", "--all-targets", "--", "-D", "warnings"],
        },
      },
    ],
  },
  {
    "label": "Type-check only; no linking",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-onchain",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "Type-check only; no linking",
        "build": {
          "command": "cargo",
          "args": ["check"],
        },
      },
    ],
  },
  {
    "label": "Browse Rust Docs locally",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-onchain",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "Browse Rust Docs locally",
        "build": {
          "command": "cargo",
          "args": ["doc", "--open", "--document-private-items"],
        },
      },
    ],
  },
  {
    "label": "CI Docs check",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-onchain",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "CI Docs check",
        "build": {
          "command": "cargo",
          "args": ["doc", "--open"],
          "RUSTDOCFLAGS": ["--cfg", "docsrs", "-D", "warnings", "cargo", "doc"],
        },
      },
    ],
  },
  {
    "label": "Run all deterministic tests",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-onchain",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "Run all deterministic tests",
        "build": {
          "command": "cargo",
          "args": ["test"],
        },
      },
    ],
  },
  {
    "label": "Build & Debug native binary",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/binary",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "configurations": [
      {
        "name": "Build & Debug native binary",
        "build": {
          "command": "cargo",
          "args": ["test"],
        },
      },
    ],
  },
  {
    "label": "Run Signer Demo",
    "adapter": "CodeLLDB",
    "type": "lldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/binary",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "env": {
      "RUST_LOG": "polar_bear_rig_onchain=debug",
    },
    "configurations": [
      {
        "name": "Run Signer Demo",
        "run": {
          "command": "cargo",
          "args": ["run"],
          "params": ["--mode", "full"],
        },
      },
    ],
  },
]
